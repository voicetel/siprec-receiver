# siprec-receiver configuration (see README.md for the full table)
SIPREC_LISTEN=127.0.0.1:5070
SIPREC_NETWORKS=udp,tcp
SIPREC_LOCAL_IP=127.0.0.1
# SIP_TLS_LISTEN=127.0.0.1:5071
# SIP_TLS_CERT=/path/to/cert.pem
# SIP_TLS_KEY=/path/to/key.pem
RTP_PORT_MIN=41000
RTP_PORT_MAX=42000
RECORDING_DIR=./data/recordings
DB_PATH=./data/siprec-receiver.db
HTTP_LISTEN=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
NOTIFY_SECRET=change-me-to-a-long-random-string
# DEV ONLY — bypasses Google sign-in; never set in production:
# DEV_AUTH_EMAIL=admin@example.com
RETENTION_DAYS=0
CALLBROADCAST_BASE_URL=
